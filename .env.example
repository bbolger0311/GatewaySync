# Database (Prisma). Any Postgres works — e.g. `npx prisma dev` for a local
# instance, or a hosted one (Neon, Supabase, etc).
DATABASE_URL="postgresql://user:password@localhost:5432/portal_bridge?schema=public"

# Clerk (https://dashboard.clerk.com) — Configure → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts portal OAuth tokens/client secrets and API keys before they're
# stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Coupa, Ariba, Procurify, Zycus, AvidXchange, Ramp, and Stampli credentials
# are NOT set here. Each is a per-tenant enterprise system — every
# organization using GatewaySync connects its own instance/tenant of these
# portals (e.g. two orgs both connecting "Coupa" are almost always talking
# to two different Coupa tenants with two different OAuth apps). So those
# credentials are entered per-organization on the Portal Links page
# (/dashboard/portal-links) instead of as global env vars here, stored
# encrypted in the PortalOAuthClient table. See lib/portals/config.ts.

# Tipalti Procurement API — no OAuth flow. Each org pastes its own API key
# in the Portal Links page (stored encrypted, same as OAuth tokens); this
# just picks which of Tipalti's two fixed base URLs to call.
# See: https://help.tipalti.com/hc/en-us/articles/30718248220823
TIPALTI_ENVIRONMENT="sandbox" # "sandbox" or "production"
