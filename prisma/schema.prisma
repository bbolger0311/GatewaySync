// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Portal {
  COUPA
  ARIBA
  PROCURIFY
  ZYCUS
  AVIDXCHANGE
  TIPALTI
  RAMP
  STAMPLI
}

enum SubmissionStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Mirrors a Clerk Organization. Organizations are the billing unit (the
// $400/mo plan is org-scoped in Clerk) and, per Brett, also the sharing
// unit — every member of a paying org sees the same portal connections,
// purchase orders, and invoice history.
model Organization {
  id          String   @id @default(cuid())
  clerkOrgId  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portalConnections  PortalConnection[]
  portalOAuthClients PortalOAuthClient[]
  invoiceSubmissions InvoiceSubmission[]
}

// Mirrors the signed-in Clerk user. Clerk owns credentials/verification;
// this row exists purely for audit trails (who connected a portal, who
// submitted an invoice) — it no longer owns any data itself.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedInvoices InvoiceSubmission[]
}

// One row per organization per linked portal — shared by every member of
// the org. accessTokenCipher holds the OAuth access token for OAuth portals
// (Coupa, Ariba, Procurify, Zycus, AvidXchange) or the API key for API-key
// portals (Tipalti); either way it's encrypted at rest with
// lib/encryption.ts before hitting the database. refreshTokenCipher,
// tokenExpiresAt, and scope are OAuth-only and stay null for API-key portals.
model PortalConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which member linked this connection, kept for display/audit only —
  // access is governed by org membership, not this field.
  connectedByUserId String?

  portal Portal

  externalAccountId  String? // account/user id on the Coupa or Ariba side
  accessTokenCipher  String    @db.Text
  refreshTokenCipher String?   @db.Text
  tokenExpiresAt     DateTime?
  scope              String?

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, portal])
}

// Each organization's own OAuth app registration for an OAuth portal — e.g.
// Coupa is per-tenant, so a GatewaySync org whose buyer runs Coupa has to
// register its own OAuth client in that buyer's Coupa instance and enter
// the resulting authorize/token URLs and client id/secret here. There is no
// platform-wide client: two different orgs connecting "Coupa" are very
// likely talking to two entirely different Coupa tenants. This is looked up
// before starting the /authorize redirect and again in /callback for the
// token exchange. Tipalti has no equivalent row since its fixed base URLs
// live in an env var (lib/portals/config.ts) and its only per-org secret is
// the API key already stored directly on PortalConnection.
model PortalOAuthClient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  portal Portal

  authorizeUrl       String
  tokenUrl           String
  clientId           String
  clientSecretCipher String  @db.Text
  scope              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, portal])
}

// Cached snapshot of an open PO pulled from a portal's API, plus the
// dynamic fields required to submit an invoice against it. Refreshed
// on demand; drives the consolidated PO table, filtering, and export.
model PurchaseOrder {
  id                 String           @id @default(cuid())
  portalConnectionId String
  portalConnection   PortalConnection @relation(fields: [portalConnectionId], references: [id], onDelete: Cascade)

  portal           Portal
  externalPoNumber String
  vendorName       String?
  description      String?
  requiredFields   Json // field schema returned by the portal for invoice submission
  rawData          Json // full PO payload as returned by the portal API

  lastSyncedAt DateTime @default(now())

  invoiceSubmissions InvoiceSubmission[]

  @@unique([portalConnectionId, externalPoNumber])
  @@index([portal, externalPoNumber])
}

// An invoice submission attempt against a specific PO, visible to the
// whole organization — not just whoever submitted it.
model InvoiceSubmission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which member submitted it, kept for display/audit only.
  submittedByUserId String?
  submittedByUser   User?   @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  portal          Portal
  submittedFields Json // values entered, keyed by the PO's requiredFields
  attachmentUrl   String? // stored PDF invoice, if attached

  status         SubmissionStatus @default(PENDING)
  portalMessage  String? // human-readable confirmation/rejection note from the portal
  portalResponse Json? // raw confirmation/error payload from the portal

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}
